# AIDI Gateway v21 runtime configuration.
AIDI_GATEWAY_HOST=0.0.0.0
AIDI_GATEWAY_PORT=8088
AIDI_OLLAMA_URL=http://192.168.10.218:11434/api/chat
AIDI_OLLAMA_MODEL=qwen3-coder:30b
AIDI_LLM_CACHE_SECONDS=900

# Optional persistent vector memory. Leave URL empty for bounded in-process memory.
AIDI_QDRANT_URL=
AIDI_QDRANT_COLLECTION=galaxy_ai_scene_memory_v21
# AIDI_QDRANT_API_KEY=
AIDI_QDRANT_TIMEOUT_SECONDS=2.5
AIDI_MEMORY_LOCAL_ENTRIES=48
AIDI_MEMORY_SCORE_THRESHOLD=0.86
